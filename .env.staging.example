# NutriChat AI Staging Environment Variables Template

APP_NAME=NutriChat-AI-Staging
ENV=staging
DEBUG=true
PORT=8000

POSTGRES_USER=nutrichat_staging_user
POSTGRES_PASSWORD=staging_password_123
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=nutrichat_staging
DATABASE_URL=postgresql://nutrichat_staging_user:staging_password_123@db:5432/nutrichat_staging

REDIS_PASSWORD=staging_redis_secret
REDIS_URL=redis://:staging_redis_secret@redis:6379/0
CELERY_BROKER_URL=redis://:staging_redis_secret@redis:6379/1
CELERY_RESULT_BACKEND=redis://:staging_redis_secret@redis:6379/2

JWT_SECRET=staging_jwt_secret_key_for_testing
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

GEMINI_API_KEY=YOUR_STAGING_GEMINI_KEY
FACEBOOK_APP_SECRET=YOUR_STAGING_FB_SECRET
FACEBOOK_VERIFY_TOKEN=staging_verify_token

NEXT_PUBLIC_API_URL=https://staging-api.nutrichat.ai/api/v1
CORS_ORIGINS=["https://staging.nutrichat.ai"]
