# NutriChat AI Production Environment Variables Template

APP_NAME=NutriChat-AI
ENV=production
DEBUG=false
PORT=8000

# PostgreSQL Production Credentials
POSTGRES_USER=nutrichat_prod_user
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PROD_PASSWORD_32_CHARS
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=nutrichat_production
DATABASE_URL=postgresql://nutrichat_prod_user:CHANGE_ME_SECURE_PROD_PASSWORD_32_CHARS@db:5432/nutrichat_production

# Redis & Queue Production
REDIS_PASSWORD=CHANGE_ME_REDIS_SECRET_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_SECRET_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_SECRET_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_SECRET_PASSWORD@redis:6379/2

# JWT Security
JWT_SECRET=CHANGE_ME_JWT_SECRET_KEY_MINIMUM_64_CHARACTERS_LONG
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Third-Party Integrations
GEMINI_API_KEY=AIzaSyB_YOUR_PRODUCTION_GEMINI_API_KEY
FACEBOOK_APP_SECRET=YOUR_WHATSAPP_FACEBOOK_APP_SECRET
FACEBOOK_VERIFY_TOKEN=YOUR_WHATSAPP_VERIFY_TOKEN
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Frontend & CORS
NEXT_PUBLIC_API_URL=https://api.nutrichat.ai/api/v1
CORS_ORIGINS=["https://nutrichat.ai", "https://app.nutrichat.ai"]
