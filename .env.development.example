# NutriChat AI Development Environment Variables Template

APP_NAME=NutriChat-AI-Dev
ENV=development
DEBUG=true
PORT=8000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nutrichat
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nutrichat

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

JWT_SECRET=dev_secret_key_1234567890
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

GEMINI_API_KEY=YOUR_DEV_GEMINI_KEY
FACEBOOK_APP_SECRET=dev_fb_secret
FACEBOOK_VERIFY_TOKEN=nutrichat_verify_secret_2026

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=["http://localhost:3000"]
