# NutriChat AI Backend Environment Variables Template

# App Configuration
APP_NAME=NutriChat-AI
ENV=development
DEBUG=true
PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=nutrichat
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@db:5432/nutrichat

# Caching and Task Queue
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Security Configurations
JWT_SECRET=super_secret_jwt_signing_token_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=2

# Webhook Security
FACEBOOK_APP_SECRET=facebook_app_secret_value_for_hmac_sha256_checks
FACEBOOK_VERIFY_TOKEN=facebook_verify_token_value_for_get_verification

# Third-party Integrations
GEMINI_API_KEY=gemini_api_key_here
EDAMAM_APP_ID=edamam_app_id_here
EDAMAM_APP_KEY=edamam_app_key_here
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
